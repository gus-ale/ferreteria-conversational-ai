APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./ferreteria_conversational.db
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

# demo funciona sin credenciales; openai activa Responses API.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
MAX_AGENT_TURNS=4

# La voz se activa después de configurar OPENAI_API_KEY.
REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

ADMIN_API_KEY=development-admin-key-change-me
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000","http://localhost:4200"]
LOG_LEVEL=INFO
INPUT_MAX_CHARACTERS=2000
CHAT_HISTORY_MESSAGES=14
RAG_TOP_K=4

